# environments and tool homes
.venv/
.home/
.cache/
tools/foundry/
tools/forge-std/
tools/downloads/**/*.tar.gz

# runtime
run/
logs/
*.pid

# secrets: never commit keys, wallets or env files with credentials
.env
*.key
*.pem
**/wallets/
**/.secrets/

# python / foundry build output
__pycache__/
*.pyc
out/
cache/
broadcast/


# vendored forge-std for the vault spike
chain/vault/lib/
chain/vault/out/

# platform runtime (private DB + public exports are regenerated at runtime)
platform/data/
platform/public/

# release data: verified state snapshots, prepared task projects, pin logs (large; content-addressed)
runner-data/

# ---- private: stays on the server, never in the public repository ----
# keys and tokens kept beside the code
run/
*.token
# internal documents (investor material, research, decisions, plans, operations runbook)
docs/investor/
docs/research/
docs/architecture.md
docs/decisions.md
docs/design-v1.0-notes.md
docs/final-plan-*.md
